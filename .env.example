# =====================================================================================================
# job-hunt-toolkit: ONE settings file for all three tools (email script, auto-apply agent, Dossier).
# Copy this file to .env and fill it in:   cp .env.example .env
# .env is git-ignored: it stays on your machine. Re-run ./setup.sh after editing it.
#
# Format: KEY=value. Multi-line values go in "double quotes" and may span lines.
# ${OTHER_KEY} inside a value is replaced by that key's value. Lists: one item per line, or a|b|c.
# =====================================================================================================

# ---------- 1. Who you are (used in emails, application forms and Dossier) ----------
FULL_NAME=Your Name
FIRST_NAME=Your
LAST_NAME=Name
EMAIL=you@example.com
PHONE=+91 9000000000
CITY=Pune
COUNTRY=India
LINKEDIN_URL=https://www.linkedin.com/in/your-profile
GITHUB_URL=https://github.com/your-username
PORTFOLIO_URL=
CURRENT_TITLE=AI/ML Engineer
CURRENT_COMPANY=

# ---------- 2. Screening answers (forms ask these all the time; answer truthfully) ----------
TOTAL_YEARS=1
# "Years of experience with <skill>" answers are never more than this
SKILL_YEARS=1
CURRENT_CTC_INR=800000
EXPECTED_CTC_INR=1200000
# same numbers in lakhs, for emails
CURRENT_CTC_LPA=8
EXPECTED_CTC_LPA=12
NOTICE_DAYS=30
WILLING_TO_RELOCATE=Yes
ONSITE_OK=Yes
WORK_AUTHORIZED=Yes
NEEDS_SPONSORSHIP=No
HAS_PASSPORT=Yes
NIGHT_SHIFTS_OK=Yes
HAS_LAPTOP=Yes
SKILLS=Python, FastAPI, LangChain, RAG, LLMs, Docker, SQL
EDUCATION=B.Tech in Computer Science, Example Institute, 2021-2025
REASON_FOR_CHANGE=Looking for a full-time role with more ownership of production AI systems.
SHORT_PITCH=AI/ML engineer who ships production LLM applications end to end in Python.
# Facts the extension may use in free-text answers (keep numbers exactly as on your resume)
FACT_NOTES=Built RAG pipelines and agentic workflows in production. Uses Git, Docker and CI/CD daily.
# Prepared answers for screening and free-text questions: one fact per line, all true
ANSWER_BANK="Education: ${EDUCATION}.
Experience: <role, company, dates, one-line impact> (one line per job)
Skills: ${SKILLS}.
Location: ${CITY}. Notice period ${NOTICE_DAYS} days. Current CTC ${CURRENT_CTC_LPA} LPA, expected ${EXPECTED_CTC_LPA} LPA.
Valid passport: ${HAS_PASSPORT}. Night shifts OK: ${NIGHT_SHIFTS_OK}. Own laptop: ${HAS_LAPTOP}.
Reason for change: ${REASON_FOR_CHANGE}
Short pitch: ${SHORT_PITCH}"

# ---------- 3. Resumes ----------
RESUME_PDF=~/Documents/resume.pdf
# file name the email attachment gets
RESUME_ATTACHMENT_NAME=${FIRST_NAME}_${LAST_NAME}_Resume.pdf

# ---------- 4. The jobs you want (used by the email script) ----------
TARGET_TITLE=AI/ML Engineer
# job titles, one per line (used for the optional rotating searches; type them into the extension's panel too)
TARGET_ROLES="AI Engineer
Generative AI Engineer
LLM Engineer
Machine Learning Engineer"
# on-site / hybrid is fine in these places (remote is always fine)
TARGET_CITIES=pune|pimpri|hinjewadi
# skip postings asking more years than this; empty = apply regardless
MAX_YEARS_ASKED=
# words that make a posting an AI/ML role (regex alternatives)
ROLE_WORDS=ai|ml|llms?|genai|gen ai|generative|agentic|machine learning|deep learning|nlp|computer vision|rag|mlops

# ---------- 5. Tool 1: cold-email script (LinkedIn posts -> emails with your resume) ----------
# A separate LinkedIn account is safer for scraping.
LINKEDIN_EMAIL=you.linkedin@example.com
SENDER_EMAIL=${EMAIL}
# Leave these empty to keep them in the macOS Keychain instead (recommended): ./setup.sh --store-secrets
LINKEDIN_PASS=
# Gmail App Password (Google Account -> Security -> App passwords), not your normal password
SENDER_PASS=
KEYCHAIN_SERVICE=job-hunt-toolkit
# LinkedIn post searches, run every time (short queries work best)
SEARCH_QUERIES="hiring AI engineer remote India
hiring GenAI engineer remote India
hiring LLM engineer remote India"
# --city runs only these (on-site / hybrid searches in your cities, past week)
CITY_QUERIES="hiring AI engineer Pune
hiring ML engineer Pune"
# true = also search a rotating pool of 'hiring <TARGET_ROLE> remote India' queries (more leads, more LinkedIn use)
ROTATING_QUERIES=false
# true = only product / AI companies, your cities or remote, no agencies or IT services
STRICT_FIT=true
REMOTE_ONLY=false
SEND_DAILY_CAP=100
MAIL_LIMIT=150
# folder for sent_emails.txt (never emailed twice), logs and the logged-in LinkedIn browser profile; empty = email-script/data
DATA_DIR=
# never email these domains (e.g. your current employer)
BLOCK_DOMAINS=
# Email to a named person ({name} = their first name)
EMAIL_REFERRAL_SUBJECT=Referral Request: ${TARGET_TITLE} | ${FULL_NAME}
EMAIL_REFERRAL_BODY="Hi {name},

I hope you are doing well. I am ${FULL_NAME}, a ${CURRENT_TITLE} based in ${CITY}. I am exploring ${TARGET_TITLE} opportunities and would be grateful if you could refer me or forward my resume to the hiring team.

A brief overview of my work:
- <your strongest result, with the number from your resume>
- <second result>

Current location: ${CITY} | Notice period: ${NOTICE_DAYS} days | Current CTC: ${CURRENT_CTC_LPA} LPA | Expected CTC: ${EXPECTED_CTC_LPA} LPA

I have attached my resume. Thank you for your time.

Best regards,
${FULL_NAME}
${PHONE} | ${EMAIL}"
# Email to a shared inbox (careers@, hr@, jobs@)
EMAIL_APPLICATION_SUBJECT=Application: ${TARGET_TITLE} | ${FULL_NAME}
EMAIL_APPLICATION_BODY="Dear Hiring Team,

I am ${FULL_NAME}, a ${CURRENT_TITLE} based in ${CITY}, and I would like to apply for ${TARGET_TITLE} opportunities in your organisation. My resume is attached.

A brief overview of my work:
- <your strongest result>
- <second result>

Current location: ${CITY} | Notice period: ${NOTICE_DAYS} days | Current CTC: ${CURRENT_CTC_LPA} LPA | Expected CTC: ${EXPECTED_CTC_LPA} LPA

Best regards,
${FULL_NAME}
${PHONE} | ${EMAIL}"

# ---------- 6. Tool 2: auto-apply browser extension (Chrome + local Ollama model) ----------
# git URL of the extension (see README → Auto-apply agent); setup downloads it into AGENT_DIR
AGENT_REPO=
AGENT_DIR=~/job-hunt-agent
OLLAMA_MODEL=qwen2.5:7b-instruct
# Job titles, cities, sites, limits and mode are set in the extension's own panel (README has suggested values).

# ---------- 7. Tool 3: Dossier (tailored resume + cover letter per job, self-hosted in Docker) ----------
DOSSIER_DIR=~/dossier
DOSSIER_PORT=3000
DOSSIER_URL=http://localhost:${DOSSIER_PORT}
DOSSIER_AI_MODEL=${OLLAMA_MODEL}
# DIRECT | WARM | FORMAL
DOSSIER_TONE=DIRECT
# your profile for Dossier (export format); start from dossier/profile.example.json
DOSSIER_PROFILE_JSON=./dossier/profile.json
# instruction sent with every application (keeps the local model honest)
DOSSIER_NOTE=Write in the first person. Never say I lack a skill my profile shows. Keep every number exactly as in the profile; add no new numbers. Never copy the posting's experience range.
